# ==============================================================================
# Samba Server Configuration
# Copy this file to .env to override defaults, or run `docker compose up -d`
# ==============================================================================

# Directory on the host to share
# Windows: ./shared or C:/MyFolder
# Linux/macOS: ./shared or /home/username/shared
DATA_DIR=./shared

# Share name visible on network (smb://<HOST_IP>/Shared)
SAMBA_SHARE_NAME=Shared

# User Authentication (Recommended for Windows 10/11 & macOS)
SAMBA_USER=sambauser
SAMBA_PASSWORD=samba123

# Guest Access (yes = allow unauthenticated guest, no = authenticated user only)
SAMBA_GUEST_OK=yes

# Read Only (no = read & write, yes = read only)
SAMBA_READ_ONLY=no

# User & Group Mapping (LinuxServer.io standard PUID/PGID)
PUID=1000
PGID=1000

# Direct SMB Port
SMB_PORT=445
